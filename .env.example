# Copy to .env and fill in. Never commit .env.

# Domain pointing to this server (A record). Use "localhost" to test locally.
N8N_DOMAIN=n8n.example.com
# Only needed when HTTPS_PORT is not 443, e.g. https://192.168.1.10:8443/
# N8N_PUBLIC_URL=

# Generate with: openssl rand -hex 32
# KEEP THIS SAFE: without it, saved credentials in backups cannot be decrypted.
N8N_ENCRYPTION_KEY=change-me

# Database
POSTGRES_DB=n8n
POSTGRES_USER=n8n
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Pin versions for production (check releases before updating)
N8N_VERSION=stable
POSTGRES_VERSION=16
CADDY_VERSION=2

TIMEZONE=Europe/Brussels

# DNS servers used by n8n and Caddy (avoids VPN resolvers that refuse public names)
DNS_PRIMARY=1.1.1.1
DNS_SECONDARY=9.9.9.9

# Delete execution history older than this (hours). 336 = 14 days
EXECUTIONS_MAX_AGE_HOURS=336

# Nightly database backup at 03:00, keep 14 days
BACKUP_CRON=0 3 * * *
BACKUP_KEEP_DAYS=14

# Change if 80/443 are already used on this host (e.g. on Unraid)
HTTP_PORT=80
HTTPS_PORT=443
