# Caddy gets and renews the HTTPS certificate automatically.
# With N8N_DOMAIN=localhost it uses its own local certificate authority instead.

{
	# Clients connecting by IP address send no SNI; serve this site's
	# certificate anyway instead of failing the TLS handshake.
	default_sni {$N8N_DOMAIN}
}

{$N8N_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy n8n:5678
}
